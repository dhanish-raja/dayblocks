// SQLite compatible schema for local runtime

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  timezone     String     @default("UTC")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  days         Day[]
  templates    Template[]

  @@index([email])
}

model Day {
  id            String            @id @default(cuid())
  userId        String
  date          DateTime
  title         String?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  configuration DayConfiguration?
  blocks        TimeBlock[]

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model DayConfiguration {
  id                   String   @id @default(cuid())
  dayId                String   @unique
  startTime            String // "09:00"
  endTime              String // "15:00"
  defaultBlockDuration Int? // minutes
  numberOfSections     Int?
  mode                 String // "DURATION" | "SECTIONS" | "CUSTOM"
  breaks               String   @default("[]") // JSON stringified Array of breaks
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  day                  Day      @relation(fields: [dayId], references: [id], onDelete: Cascade)
}

model TimeBlock {
  id         String   @id @default(cuid())
  dayId      String
  startTime  String // "09:00"
  endTime    String // "09:30"
  type       String // "JOURNAL" | "BREAK" | "CUSTOM"
  title      String?
  content    String?
  mood       String? // e.g. "great", "good", "neutral", "bad", "terrible"
  tags       String   @default("") // Comma-separated or JSON stringified tags
  completed  Boolean  @default(false)
  orderIndex Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  day        Day      @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
  @@index([dayId, orderIndex])
  @@index([startTime])
}

model Template {
  id                   String   @id @default(cuid())
  userId               String
  name                 String
  description          String?
  startTime            String
  endTime              String
  defaultBlockDuration Int?
  numberOfSections     Int?
  mode                 String // "DURATION" | "SECTIONS" | "CUSTOM"
  breaks               String   @default("[]") // JSON stringified Array of breaks
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}
